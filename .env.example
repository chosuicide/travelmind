# 复制为 .env 后填写真实密钥；不要把 .env 提交到版本库。
# 不填写时默认使用项目根目录的 travelmind.db。
# DATABASE_URL=postgresql+psycopg://user:password@localhost/travelmind
# JWT 密钥至少 32 个随机字符，不能继续使用下面的示例值。
JWT_SECRET_KEY=replace-with-a-long-random-secret
DEEPSEEK_API_KEY=
AMAP_API_KEY=

# Worker 默认每 2 秒轮询；运行超过 30 分钟的中断任务会标记失败。
GENERATION_WORKER_POLL_SECONDS=2
GENERATION_STALE_AFTER_MINUTES=30

# 0 表示不限制，适合本地学习和开源演示；公开部署时可以自行设置。
MAX_CHAT_MESSAGES_PER_MINUTE=0
MAX_CHAT_MESSAGES_PER_DAY=0
MAX_GENERATIONS_PER_MINUTE=0
MAX_GENERATIONS_PER_DAY=0

# LangGraph 本地持久化检查点；PostgreSQL 部署时可替换对应 Saver。
LANGGRAPH_CHECKPOINT_PATH=.runtime/langgraph-checkpoints.db
